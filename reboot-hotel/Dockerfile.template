# Use minimal debian image
FROM debian:bookworm-slim

# Define build arguments for binary name and config file
ARG BINARY_PATH
ARG BINARY_NAME
ARG SNIPPET_PATH
ARG HOTEL_CONFIG

# Verify required build arguments are provided
RUN if [ -z "$BINARY_PATH" ]; then \
    echo "Error: BINARY_PATH argument is required" && exit 1; \
    fi
RUN if [ -z "$BINARY_NAME" ]; then \
    echo "Error: BINARY_NAME argument is required" && exit 1; \
    fi
RUN if [ -z "$SNIPPET_PATH" ]; then \
    echo "Error: SNIPPET_PATH argument is required" && exit 1; \
    fi
RUN if [ -z "$HOTEL_CONFIG" ]; then \
    echo "Error: HOTEL_CONFIG argument is required" && exit 1; \
    fi

ENV BINARY_NAME=${BINARY_NAME}
ENV HOTEL_CONFIG=${HOTEL_CONFIG}

RUN apt-get update
RUN apt-get install -y openssl libssl-dev
RUN apt-get install -y libc-bin wget

# install libssl 1.1
RUN wget http://security.ubuntu.com/ubuntu/pool/main/o/openssl/libssl1.1_1.1.1f-1ubuntu2_amd64.deb
RUN dpkg -i libssl1.1_1.1.1f-1ubuntu2_amd64.deb

# Create a non-root user for security
RUN useradd -r -s /bin/false appuser

# Create directory structure
RUN mkdir -p /app/config && \
    chown -R appuser:appuser /app

# Copy the binary and config file from build context
COPY ${BINARY_PATH}/${BINARY_NAME} /app/
COPY ${SNIPPET_PATH}/${HOTEL_CONFIG} /app/config/

# Set proper permissions
RUN chown appuser:appuser /app/${BINARY_NAME} && \
    chmod +x /app/${BINARY_NAME} && \
    chown appuser:appuser /app/config/${HOTEL_CONFIG}

# Switch to non-root user
USER appuser

# Set working directory
WORKDIR /app

ENV TRACKER_CAPACITY=512
ENV PCTL_DEADLINE=50
ENV PCTL_LATEST_EXEC=50
# Set the entrypoint to run the binary with config file
CMD ./${BINARY_NAME} --config /app/config/${HOTEL_CONFIG}
