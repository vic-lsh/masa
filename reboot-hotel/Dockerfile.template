# Use minimal debian image
FROM debian:bookworm-slim

# Define build arguments for binary name and config file
ARG BINARY_NAME
ARG BINARY_PATH=.  # Default to current directory, can be overridden
ARG CONFIG_NAME
ARG CONFIG_PATH=.  # Default to current directory, can be overridden

# Verify required build arguments are provided
RUN if [ -z "$BINARY_NAME" ]; then \
    echo "Error: BINARY_NAME build argument is required" && exit 1; \
    fi
RUN if [ -z "$CONFIG_NAME" ]; then \
    echo "Error: CONFIG_NAME build argument is required" && exit 1; \
    fi


RUN apt update
RUN apt install -y openssl libssl-dev
RUN apt-get install -y libc-bin wget
RUN ldconfig -p | grep libssl

# install libssl 1.1
RUN wget http://security.ubuntu.com/ubuntu/pool/main/o/openssl/libssl1.1_1.1.1f-1ubuntu2_amd64.deb
RUN dpkg -i libssl1.1_1.1.1f-1ubuntu2_amd64.deb

# Create a non-root user for security
RUN useradd -r -s /bin/false appuser

# Create directory structure
RUN mkdir -p /app/config && \
    chown -R appuser:appuser /app

# Copy the binary and config file from build context
COPY ${BINARY_PATH}/${BINARY_NAME} /app/
COPY ${CONFIG_PATH}/${CONFIG_NAME} /app/config/

# Set proper permissions
RUN chown appuser:appuser /app/${BINARY_NAME} && \
    chmod +x /app/${BINARY_NAME} && \
    chown appuser:appuser /app/config/${CONFIG_NAME}

# Switch to non-root user
USER appuser

# Set working directory
WORKDIR /app

# masa environment variables
ENV TRACKER_CAPACITY=512
ENV PCTL_DEADLINE=50
ENV PCTL_LATEST_EXEC=50

# expose these build-time args as runtime env vars
# so that the interpolation works correctly in CMD
ENV BINARY_NAME=${BINARY_NAME}
ENV CONFIG_NAME=${CONFIG_NAME}

ENTRYPOINT [ "sh", "-c" ]
CMD ["./${BINARY_NAME} --config /app/config/${CONFIG_NAME}"]
